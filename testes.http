### 1. Login - ADMIN
# @name loginAdmin
POST http://localhost:3333/api/auth/login-teste
Content-Type: application/json

{
  "id": "1",
  "email": "admin@nexhub.com",
  "role": "ADMIN"
}

### 2. Login - STARTUP
# @name loginStartup
POST http://localhost:3333/api/auth/login-teste
Content-Type: application/json

{
  "id": "2",
  "email": "startup@nexhub.com",
  "role": "STARTUP"
}

### 3. Login - INVESTIDOR
# @name loginInvestidor
POST http://localhost:3333/api/auth/login-teste
Content-Type: application/json

{
  "id": "3",
  "email": "investidor@nexhub.com",
  "role": "INVESTIDOR"
}

### ----------------------------------------------------
### TESTES DE ACESSO POR PERFIL (RBAC)
### ----------------------------------------------------

### 4. Rota Apenas ADMIN (Sucesso com Admin)
