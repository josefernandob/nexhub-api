GET http://localhost:3333/api/auth/admin-only
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiIxIiwiZW1haWwiOiJhZG1pbkBuZXhodWIuY29tIiwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzkwMDE2NDgxLCJleHAiOjE3OTAxMDI4ODF9.C7ZTe2YUru5lSYZIPpQEY72m3tmGR1v3oc64kGTjDYg

