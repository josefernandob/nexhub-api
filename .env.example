# Copie este arquivo para .env e preencha os valores apenas localmente.
PORT=3333

# Chave privada usada pelo backend para assinar tokens; nao e uma chave do Supabase.
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA"

# Cole a URI PostgreSQL de Connect > Session pooler no Supabase.
# Substitua o marcador de senha pela senha do banco, codificada para URL.
# Nunca coloque esta credencial no frontend ou no Git.
DATABASE_URL=""

# Caminho do certificado CA baixado do Supabase (não desative a validação TLS).
DATABASE_CA_PATH="C:/caminho/prod-ca-2021.crt"
FRONTEND_ORIGIN="http://localhost:5173"

# Necessários somente para recuperação real por e-mail.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
